
# .env.example → コピーして .env にリネームし、実値を入れること
OPENAI_API_KEY=
SUPABASE_URL=
SUPABASE_KEY=
FLASK_SECRET_KEY=

# 任意。ローカル開発でデバッグモード(詳細なエラー画面)を使いたい時だけ 1 にする。
# 本番では絶対に設定しないこと(コードが露出する危険がある)。
FLASK_DEBUG=

# /admin/update-ratings を叩くときの合言葉。任意の文字列でよい。
# (docs/suggestion_diversity/README.md 参照)
ADMIN_SECRET=

# 「探すクエスト」機能で使う地図表示用。クレジットカード登録不要の
# Maps Demo Keyを使用(https://mapsplatform.google.com/maps-demo-key/)。
# プロトタイプ用のキーのため、本番投入時は標準キーへの切り替えを検討すること。
# (docs/search_quest/README.md 参照)
GOOGLE_MAPS_API_KEY=

